---
import { site } from '../site.config.mjs';
import { url } from '../lib/helpers.mjs';

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Courier+Prime:wght@400;700&family=Libre+Franklin:wght@400;600;700;800&family=Stardos+Stencil:wght@700&display=swap">

<link rel="stylesheet" href={url('/assets/css/styles.css')}>
<script src={url('/assets/js/main.js')} defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
  <p class="topbar">Farm stand open <strong>Fri to Sun, 9 to 6</strong> on County Road B. The honor box never closes.</p>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href={url('/')} aria-label="Bramblecut Farm, home">
        <img src={url('/assets/img/mark.svg')} alt="" width="46" height="46">
        <span>Bramblecut<small>Farm · Est. 2011</small></span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span aria-hidden="true"></span>Menu</button>
      <nav class="nav" id="site-nav" aria-label="Main">
        <ul>
          <li><a href={url('/')} aria-current={Astro.url.pathname === url('/') ? 'page' : undefined}>Home</a></li>
          <li><a href={url('/pricing/')} aria-current={Astro.url.pathname === url('/pricing/') ? 'page' : undefined}>Shares &amp; pricing</a></li>
          <li><a href={url('/about/')} aria-current={Astro.url.pathname === url('/about/') ? 'page' : undefined}>About the farm</a></li>
          <li><a href={url('/blog/')} aria-current={Astro.url.pathname === url('/blog/') ? 'page' : undefined}>Farm notes</a></li>
          <li><a href={url('/contact/')} aria-current={Astro.url.pathname === url('/contact/') ? 'page' : undefined}>Contact</a></li>
        </ul>
        <a class="btn btn--sm" href={url('/pricing/')}>Join the CSA</a>
      </nav>
    </div>
  </header>
<slot />
<footer class="site-footer">
    <div class="wrap">
      <div>
        <a class="logo" href={url('/')} aria-label="Bramblecut Farm, home"><img src={url('/assets/img/mark.svg')} alt="" width="46" height="46"><span>Bramblecut<small>Farm · Est. 2011</small></span></a>
        <p>Certified organic vegetables from 22 acres of Driftless hillside near Viroqua, Wisconsin. Grown by five people, a lot of volunteers, and one very old tractor.</p>
      </div>
      <div>
        <h2>The farm</h2>
        <ul><li><a href={url('/')}>Home</a></li><li><a href={url('/pricing/')}>Shares &amp; pricing</a></li><li><a href={url('/about/')}>About the farm</a></li><li><a href={`${url('/about/')}#visit`}>Visit the stand</a></li><li><a href={url('/blog/')}>Farm notes</a></li><li><a href={url('/contact/')}>Contact the farm</a></li></ul>
      </div>
      <div>
        <h2>Farm stand</h2>
        <ul><li>Fri to Sun, 9 am to 6 pm</li><li>E4410 County Road B</li><li>Viroqua, WI 54665</li></ul>
      </div>
      <div>
        <h2>Write to us</h2>
        <ul><li><a href="mailto:hello@bramblecut.farm">hello@bramblecut.farm</a></li><li>(608) 555-0147</li><li>We answer after chores.</li></ul>
      </div>
      <p class="copy"><span>© {new Date().getFullYear()} Bramblecut Farm. Grown in Vernon County, Wisconsin.</span><span>Certified organic since 2014</span></p>
      <p class="theme-credit">Free theme by <a href="https://dreamr-design.github.io/dreamr-web" rel="noopener">Dreamr</a>. Built with <a href="https://chatsy.ai" rel="noopener">Chatsy AI chat</a> and <a href="https://slapform.com" rel="noopener">Slapform forms</a>.</p>
    </div>
  </footer>
{(site.chatsy_agent_id) && <Fragment>
<script src="https://cdn.jsdelivr.net/npm/chatsy@latest/dist/chatsy.min.js" data-agent-id={site.chatsy_agent_id} data-button-background-color="#862612" data-button-text-color="#FFFFFF"></script>
</Fragment>}
{(site.slapform_form_id) && <Fragment>
<script src="https://cdn.jsdelivr.net/npm/slapform@latest/dist/slapform.min.js" defer></script>
</Fragment>}

</body>
</html>
